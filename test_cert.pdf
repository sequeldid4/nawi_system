<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIH26035 - Inspector Dashboard</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <!-- Link to neobrutalism css -->
    <link rel="stylesheet" href="/static/css/neobrutalism.css">
    
    
</head>
<body>
    <header class="top-bar">
        <div class="top-bar-left">
            
            
            <button id="sidebar-toggle" style="background: var(--accent); border: 2px solid var(--border); border-radius: 4px; cursor: pointer; margin-right: 0.5rem; padding: 0.2rem 0.5rem; display: flex; align-items: center; box-shadow: 2px 2px 0px var(--border); transition: transform 0.1s;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
            
            <a href="/inspector/dashboard" class="nawi-logo" style="text-decoration: none;">NAWI</a>
            <span class="oiml-badge">OIML R-76</span>
            <span class="hide-mobile" style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                LEGAL METROLOGY VERIFICATION PLATFORM
            </span>
        </div>
        <div class="top-bar-right">
            <span class="hide-mobile">SIH26035</span>
            <span class="inspector-btn">INSPECTOR MODE</span>
            <span class="profile-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </span>
        </div>
    </header>

    <div class="app-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <!-- Session Card -->
            <div class="sidebar-session-card">
                <div style="font-size: 0.6rem; color: var(--accent); font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">Active Verification Session</div>
                <div style="font-size: 1.1rem; font-weight: 900; margin-bottom: 1rem;">ID: VER-2024-089X</div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 0.5rem;">
                    <span>Class III NAWI</span>
                    <span style="color: var(--accent);">e = 1.0g</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="sidebar-nav">
                <a href="/inspector/dashboard" class="sidebar-link active">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    DASHBOARD
                </a>
                <a href="/inspector/instrument-profile" class="sidebar-link ">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                    INSTRUMENT PROFILE
                </a>
                <a href="/inspector/weighing-test" class="sidebar-link " >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                    WEIGHING TEST
                </a>
                <a href="/inspector/repeatability-test" class="sidebar-link " >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                    REPEATABILITY TEST
                </a>
                <a href="/inspector/eccentricity-test" class="sidebar-link " >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line><line x1="10" y1="3" x2="8" y2="21"></line><line x1="16" y1="3" x2="14" y2="21"></line></svg>
                    ECCENTRICITY TEST
                </a>
                <a href="/inspector/discrimination-test" class="sidebar-link " >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg>
                    DISCRIMINATION TEST
                </a>
            </nav>

            <!-- Status Box -->
            <div class="sidebar-status-box">
                <div style="display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 0.5rem; align-items: center;">
                    <span>MPE STATUS</span>
                    <span class="badge badge-pass" style="font-size: 0.6rem; padding: 0.1rem 0.3rem;">NOMINAL</span>
                </div>
                <p style="color: #555; margin-bottom: 1rem; line-height: 1.4;">Zero error limits observed under OIML R-76-1 Sec 3.5.</p>
                <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 0.65rem; color: #777; border-top: 1px solid var(--border); padding-top: 0.5rem;">
                    <span>AUDIT TRACK: #9042</span>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <div class="container" style="max-width: 1200px; margin: 0 auto;">
                
                    
                        <div class="stack mb-8">
                            
                                <div class="alert alert-error">
                                    Cannot generate certificate — Weighing test is incomplete.
                                </div>
                            
                        </div>
                    
                

                
<!-- Sub-header metadata bar -->
<div class="mb-4" style="border-bottom: var(--border-width) solid var(--border); padding-bottom: 0.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <span class="badge badge-warn">DIRECTIVE 2014/31/EU</span> 
        OIML R-76-1:2006 (E) METROLOGICAL FRAMEWORK
    </div>
    <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="display: inline-block; width: 10px; height: 10px; background-color: var(--pass); border: 1px solid var(--border);"></span>
        SESSION TOKEN: AUTH-EU-7709-X4
    </div>
</div>

<!-- Main Titles -->
<div class="mb-8">
    <div class="text-sm font-bold uppercase mb-2" style="color: #555;">National Verification Registry • Legal Inspection Terminal</div>
    <h1 style="font-size: clamp(1.75rem, 6vw, 2.5rem); font-weight: 900; text-transform: uppercase; line-height: 1.1; margin: 0.5rem 0;">Legal Metrology Verification</h1>
    <div class="text-sm font-bold uppercase mt-2">Non-Automatic Weighing Instrument (NAWI) • Class I / II / III / IIII Field Conformity</div>
</div>

<div class="stack">
    <!-- Dynamic Instrument Profile Setup Banner -->
    <a href="/inspector/instrument-profile" class="card card-accent-top" style="background-color: var(--header-bg); color: var(--surface);">
        
            <h3 style="color: var(--accent);">01. EDIT METROLOGICAL PROFILE</h3>
            <p>Update verification scale interval, max capacity limits, load receptor geometry, and baseline certificate metadata.</p>
        
    </a>

    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: space-between; align-items: center; border-bottom: var(--border-width) solid var(--border); padding-bottom: 0.5rem; margin-top: 1rem;">
        <p class="font-bold uppercase text-sm" style="margin: 0;">Select Test Workflow</p>
        <p class="font-bold uppercase text-sm" style="margin: 0;">4 ACTIVE • 1 LOCKED</p>
    </div>

    <!-- Test Grid with Jinja2 Conditional Logic -->
    <div class="grid-3">
        <a href="/inspector/repeatability-test" class="card ">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span class="badge">STAGE 02</span>
                <span class="badge badge-pass" style="font-size: 0.65rem;">
                    DONE
                    
                </span>
            </div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">02. REPEATABILITY (§A.4.4)</h3>
            <p class="text-sm font-bold" style="color: #444;">Execute 3 series of consecutive weighings at ~0.8 Max.</p>
            <div class="btn btn-full mt-4" style="background-color: var(--surface);">ENTER READINGS &rarr;</div>
        </a>
        
        <a href="/inspector/eccentricity-test" class="card ">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span class="badge">STAGE 03</span>
                <span class="badge badge-warn" style="font-size: 0.65rem;">
                    PENDING
                    
                </span>
            </div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">03. ECCENTRIC LOADING (§A.4.7)</h3>
            <p class="text-sm font-bold" style="color: #444;">Evaluate 5-point spatial load distribution.</p>
            <div class="btn btn-full mt-4" style="background-color: var(--surface);">RUN ECCENTRICITY &rarr;</div>
        </a>
        
        <a href="/inspector/weighing-test" class="card ">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span class="badge">STAGE 04</span>
                <span class="badge badge-warn" style="font-size: 0.65rem;">
                    PENDING
                    
                </span>
            </div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">04. WEIGHING PERFORMANCE</h3>
            <p class="text-sm font-bold" style="color: #444;">Ascending and descending load series tracking against dynamic MPE.</p>
            <div class="btn btn-full mt-4" style="background-color: var(--surface);">START TEST &rarr;</div>
        </a>

        <a href="/inspector/discrimination-test" class="card ">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span class="badge">STAGE 05</span>
                <span class="badge badge-warn" style="font-size: 0.65rem;">
                    PENDING
                    
                </span>
            </div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">05. DISCRIMINATION TEST</h3>
            <p class="text-sm font-bold" style="color: #444;">Verify minimum additional load required to change indication.</p>
            <div class="btn btn-full mt-4" style="background-color: var(--surface);">START TEST &rarr;</div>
        </a>

        
        <!-- Certificate Generation Block -->
        
        <a  class="card card-locked" style="pointer-events: none; opacity: 0.7;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span class="badge">STAGE 06</span>
                <span class="badge " style="font-size: 0.65rem;">
                    LOCKED
                </span>
            </div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; ">06. OFFICIAL STAMP & CERTIFICATE</h3>
            <p class="text-sm font-bold" style="color: #444;">Generate OIML legal metrology conformity certificate and apply cryptographic seal.</p>
            <div class="btn btn-full mt-4" style="background-color: var(--surface);">
                🔒 REQUIRES 4 DONE TESTS
            </div>
        </a>
    </div>
</div>

            </div>
        </main>
    </div>

    
    
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggle = document.getElementById('sidebar-toggle');
            const sidebar = document.querySelector('.sidebar');
            if (toggle && sidebar) {
                toggle.addEventListener('click', () => {
                    sidebar.classList.toggle('collapsed');
                    toggle.style.transform = 'translate(2px, 2px)';
                    toggle.style.boxShadow = '0px 0px 0px var(--border)';
                    setTimeout(() => {
                        toggle.style.transform = 'none';
                        toggle.style.boxShadow = '2px 2px 0px var(--border)';
                    }, 100);
                });
            }
        });
    </script>
    
    

</body>
</html>